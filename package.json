{
  "name": "trucker-copilot",
  "version": "0.1.0",
  "private": true,
  "description": "WhatsApp AI co-pilot for truck drivers: reads rate cons, tracks detention, emails brokers.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx --env-file=.env src/main.ts",
    "preview": "tsx src/preview.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "try-ratecon": "tsx --env-file=.env src/try-ratecon.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "tsx": "^4.23.15"
  }
}
